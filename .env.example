# ========================================
# Portal アプリケーション デプロイ設定
# ========================================

# ========== データベース設定 ==========
DB_NAME=portal_db
DB_USER=portal_user
DB_PASSWORD=portal_password
DB_PORT=5432

# ========== バックエンド設定 ==========
BACKEND_HOST=localhost
BACKEND_PORT=8080

# ========== フロントエンド設定 ==========
FRONTEND_PORT=5173

# ========== JWT 設定 ==========
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=86400000
